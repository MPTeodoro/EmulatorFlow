{
  "name": "emulatorflow",
  "version": "1.0.5",
  "description": "Visual node-based workflow editor for mobile emulator bot automation",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/MPTeodoro/EmulatorFlow"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build && electron-builder --publish never",
    "build:win": "vite build && electron-builder --win --publish never",
    "preview": "vite preview",
    "gen-icon": "python scripts/generate_icon.py"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.emulatorflow.app",
    "productName": "EmulatorFlow",
    "copyright": "Copyright © 2025 EmulatorFlow contributors",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "engine_dist/python-engine.exe",
        "to": "engine/python-engine.exe"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EmulatorFlow"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
